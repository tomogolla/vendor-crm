# Copy to .env in the repository root. Use a real DNS name, without a scheme.
APP_DOMAIN=crm.example.com
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
# Optional invoice email. Use an SMTP provider supporting STARTTLS on port 2525.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=booking@thegoodflea.com
